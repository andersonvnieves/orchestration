AWSTemplateFormatVersion: '2010-09-09'
Description: 'Amazon DocumentDB (MongoDB‑compatible) for catalog-api'

Parameters:
  VpcId:
    Type: AWS::EC2::VPC::Id
    Description: VPC where the DocumentDB cluster will be deployed
  SubnetIds:
    Type: List<AWS::EC2::Subnet::Id>
    Description: Subnet IDs (at least two) for the DB subnet group (different AZs)
  SecurityGroupId:
    Type: AWS::EC2::SecurityGroup::Id
    Description: Security group allowing inbound on MongoDB port 27017


Resources:
  # Subnet group for DocumentDB
  DocDBSubnetGroup:
    Type: AWS::DocDB::DBSubnetGroup
    Properties:
      DBSubnetGroupDescription: Subnet group for DocumentDB catalog cluster
      SubnetIds: !Ref SubnetIds
      Tags:
        - Key: Name
          Value: fgc-docdb-catalog-subnet-group

  # DocumentDB cluster (single-instance, cheapest configuration)
  DocDBCluster:
    Type: AWS::DocDB::DBCluster
    Properties:
      DBClusterIdentifier: fgc-catalog-docdb-cluster
      Engine: docdb
      EngineVersion: "4.0"
      MasterUsername: {{resolve:ssm-secure:/fgc/catalog/mongo-user:1}}
      MasterUserPassword: {{resolve:ssm-secure:/fgc/catalog/mongo-password:1}}
      DBSubnetGroupName: !Ref DocDBSubnetGroup
      VpcSecurityGroupIds:
        - !Ref SecurityGroupId
      Port: 27017
      BackupRetentionPeriod: 7
      PreferredBackupWindow: "02:00-03:00"
      DeletionProtection: false
      Tags:
        - Key: Name
          Value: fgc-catalog-docdb-cluster

  # Single instance for the cluster
  DocDBInstance:
    Type: AWS::DocDB::DBInstance
    Properties:
      DBInstanceIdentifier: fgc-catalog-docdb-instance
      DBInstanceClass: db.t3.medium
      Engine: docdb
      DBClusterIdentifier: !Ref DocDBCluster
      PubliclyAccessible: false
      AutoMinorVersionUpgrade: true

Outputs:
  CatalogDocDBEndpoint:
    Description: Primary endpoint of the catalog DocumentDB cluster
    Value: !GetAtt DocDBCluster.Endpoint
    Export:
      Name: !Sub "${AWS::StackName}-CatalogDocDBEndpoint"
  CatalogDocDBPort:
    Description: Port for the catalog DocumentDB cluster (MongoDB default)
    Value: !GetAtt DocDBCluster.Port
    Export:
      Name: !Sub "${AWS::StackName}-CatalogDocDBPort"
